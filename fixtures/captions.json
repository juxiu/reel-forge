[
  {
    "id": "cap-001",
    "text": "通用 Agent 已经能干活了",
    "start": 3.1,
    "end": 5.167
  },
  {
    "id": "cap-002",
    "text": "但一到你的领域就不够用",
    "start": 5.467,
    "end": 6.833
  },
  {
    "id": "cap-003",
    "text": "缺的不是算力，是方法",
    "start": 7.033,
    "end": 8.733
  },
  {
    "id": "cap-004",
    "text": "所以我们需要一种",
    "start": 9,
    "end": 10.5
  },
  {
    "id": "cap-005",
    "text": "能把专长装进去的容器",
    "start": 10.7,
    "end": 12.2
  },
  {
    "id": "cap-006",
    "text": "先给结论",
    "start": 13.3,
    "end": 14.033
  },
  {
    "id": "cap-007",
    "text": "一个技能就是一个文件夹",
    "start": 14.4,
    "end": 15.833
  },
  {
    "id": "cap-008",
    "text": "里面放着一份 SKILL.md",
    "start": 16,
    "end": 17.933
  },
  {
    "id": "cap-009",
    "text": "再加可选的脚本和资料",
    "start": 18.133,
    "end": 19.667
  },
  {
    "id": "cap-010",
    "text": "Agent 会在需要时自己找到它并加载",
    "start": 19.933,
    "end": 22.633
  },
  {
    "id": "cap-011",
    "text": "你可能一直在重复粘贴同一段指令",
    "start": 23.7,
    "end": 25.8
  },
  {
    "id": "cap-012",
    "text": "那是一张清单，或者一套多步流程",
    "start": 26.067,
    "end": 28.7
  },
  {
    "id": "cap-013",
    "text": "提示词用完就散了",
    "start": 29.033,
    "end": 30.633
  },
  {
    "id": "cap-014",
    "text": "技能是把它固定下来的地方",
    "start": 31,
    "end": 32.433
  },
  {
    "id": "cap-015",
    "text": "技能和常驻配置不一样",
    "start": 33.533,
    "end": 35.3
  },
  {
    "id": "cap-016",
    "text": "正文只在使用时才被读进来",
    "start": 35.633,
    "end": 37.7
  },
  {
    "id": "cap-017",
    "text": "所以再长的参考资料",
    "start": 37.967,
    "end": 39.333
  },
  {
    "id": "cap-018",
    "text": "在真正需要之前几乎不占预算",
    "start": 39.5,
    "end": 41.767
  },
  {
    "id": "cap-019",
    "text": "技能不是工具，也不是插件",
    "start": 42.867,
    "end": 44.7
  },
  {
    "id": "cap-020",
    "text": "工具给它一双手，技能给的是方法",
    "start": 45,
    "end": 47.333
  },
  {
    "id": "cap-021",
    "text": "技能之间还能像积木一样叠加",
    "start": 47.667,
    "end": 49.967
  },
  {
    "id": "cap-022",
    "text": "现在技能已经是一个开放标准",
    "start": 51.067,
    "end": 53.067
  },
  {
    "id": "cap-023",
    "text": "同一份格式到处都能用",
    "start": 53.4,
    "end": 54.867
  },
  {
    "id": "cap-024",
    "text": "换个平台不用重写",
    "start": 55.067,
    "end": 56.3
  },
  {
    "id": "cap-025",
    "text": "拆开看，一个技能长这样",
    "start": 58.2,
    "end": 60.067
  },
  {
    "id": "cap-026",
    "text": "根目录下一份 SKILL.md",
    "start": 60.267,
    "end": 62.2
  },
  {
    "id": "cap-027",
    "text": "旁边可以有 scripts、references、assets",
    "start": 62.467,
    "end": 63.067
  },
  {
    "id": "cap-028",
    "text": "只有 SKILL.md 是必需的",
    "start": 65.533,
    "end": 67.633
  },
  {
    "id": "cap-029",
    "text": "三个目录各管一件事",
    "start": 68.733,
    "end": 70.2
  },
  {
    "id": "cap-030",
    "text": "scripts 放能直接跑的代码",
    "start": 70.867,
    "end": 72.333
  },
  {
    "id": "cap-031",
    "text": "references 放沉淀下来的文档",
    "start": 73.2,
    "end": 74.367
  },
  {
    "id": "cap-032",
    "text": "assets 放模板和素材",
    "start": 75.067,
    "end": 76.233
  },
  {
    "id": "cap-033",
    "text": "SKILL.md 分成两段",
    "start": 77.333,
    "end": 79.133
  },
  {
    "id": "cap-034",
    "text": "开头是元数据，至少两项",
    "start": 79.367,
    "end": 81.367
  },
  {
    "id": "cap-035",
    "text": "名字和描述",
    "start": 81.6,
    "end": 82.5
  },
  {
    "id": "cap-036",
    "text": "下面才是写给 Agent 看的指令",
    "start": 82.667,
    "end": 84.533
  },
  {
    "id": "cap-037",
    "text": "写技能最好的心智模型",
    "start": 85.633,
    "end": 87.4
  },
  {
    "id": "cap-038",
    "text": "是给新同事写一份入职指南",
    "start": 87.567,
    "end": 89.8
  },
  {
    "id": "cap-039",
    "text": "你把踩过的坑写清楚",
    "start": 90.2,
    "end": 91.567
  },
  {
    "id": "cap-040",
    "text": "它就不用再踩一遍",
    "start": 91.833,
    "end": 92.967
  },
  {
    "id": "cap-041",
    "text": "关键在于渐进式披露",
    "start": 94.033,
    "end": 95.533
  },
  {
    "id": "cap-042",
    "text": "描述一直挂着，但很短",
    "start": 95.833,
    "end": 97.733
  },
  {
    "id": "cap-043",
    "text": "正文命中才读",
    "start": 98,
    "end": 99.067
  },
  {
    "id": "cap-044",
    "text": "附属文件按需再取",
    "start": 99.367,
    "end": 100.733
  },
  {
    "id": "cap-045",
    "text": "这样设计是为了省上下文",
    "start": 101.833,
    "end": 103.933
  },
  {
    "id": "cap-046",
    "text": "常驻的只有一小段描述",
    "start": 104.167,
    "end": 105.667
  },
  {
    "id": "cap-047",
    "text": "所以你能同时装很多技能",
    "start": 105.967,
    "end": 108
  },
  {
    "id": "cap-048",
    "text": "而不会把窗口塞满",
    "start": 108.333,
    "end": 109.533
  },
  {
    "id": "cap-049",
    "text": "那它到底怎么被用起来",
    "start": 111.433,
    "end": 112.667
  },
  {
    "id": "cap-050",
    "text": "第一步是发现",
    "start": 113,
    "end": 113.867
  },
  {
    "id": "cap-051",
    "text": "Agent 会扫描手上所有技能",
    "start": 114.133,
    "end": 116.267
  },
  {
    "id": "cap-052",
    "text": "找出和当前任务相关的那些",
    "start": 116.433,
    "end": 118.3
  },
  {
    "id": "cap-053",
    "text": "没有匹配就完全不碰",
    "start": 119.4,
    "end": 120.933
  },
  {
    "id": "cap-054",
    "text": "只有相关时才会访问某个技能",
    "start": 121.3,
    "end": 123.633
  },
  {
    "id": "cap-055",
    "text": "所以技能多，不等于负担重",
    "start": 123.933,
    "end": 125.767
  },
  {
    "id": "cap-056",
    "text": "命中之后",
    "start": 126.867,
    "end": 127.633
  },
  {
    "id": "cap-057",
    "text": "它只加载最小的那一部分",
    "start": 127.933,
    "end": 129.533
  },
  {
    "id": "cap-058",
    "text": "必要的说明和文件就够了",
    "start": 129.8,
    "end": 131.3
  },
  {
    "id": "cap-059",
    "text": "这样还能保持响应速度",
    "start": 131.6,
    "end": 133.033
  },
  {
    "id": "cap-060",
    "text": "技能里真正干活的是脚本",
    "start": 134.133,
    "end": 135.8
  },
  {
    "id": "cap-061",
    "text": "Agent 用本地代码执行",
    "start": 136.033,
    "end": 137.867
  },
  {
    "id": "cap-062",
    "text": "配合文件系统完成任务",
    "start": 138.133,
    "end": 139.567
  },
  {
    "id": "cap-063",
    "text": "再把结论写回来",
    "start": 139.733,
    "end": 140.733
  },
  {
    "id": "cap-064",
    "text": "再回到上下文预算这条线",
    "start": 141.833,
    "end": 143.567
  },
  {
    "id": "cap-065",
    "text": "指令和资料都不常驻",
    "start": 143.833,
    "end": 145.267
  },
  {
    "id": "cap-066",
    "text": "只有命中那一刻才付出成本",
    "start": 145.567,
    "end": 147.6
  },
  {
    "id": "cap-067",
    "text": "这是它和常驻提示词最大的区别",
    "start": 147.933,
    "end": 150.133
  },
  {
    "id": "cap-068",
    "text": "一个任务往往要用好几个技能",
    "start": 151.233,
    "end": 153.333
  },
  {
    "id": "cap-069",
    "text": "它们能叠在一起",
    "start": 153.667,
    "end": 154.7
  },
  {
    "id": "cap-070",
    "text": "Agent 自己判断需要哪些",
    "start": 154.933,
    "end": 156.833
  },
  {
    "id": "cap-071",
    "text": "再协调它们一起用",
    "start": 157,
    "end": 158.1
  },
  {
    "id": "cap-072",
    "text": "如果你的技能一直没被触发",
    "start": 160.033,
    "end": 161.867
  },
  {
    "id": "cap-073",
    "text": "九成是描述没写好",
    "start": 162.1,
    "end": 163.5
  },
  {
    "id": "cap-074",
    "text": "名字和描述是唯一的常驻信息",
    "start": 163.933,
    "end": 166.2
  },
  {
    "id": "cap-075",
    "text": "写得含糊，就等于不存在",
    "start": 166.467,
    "end": 168.233
  },
  {
    "id": "cap-076",
    "text": "描述里要写清楚什么时候用它",
    "start": 169.333,
    "end": 171.6
  },
  {
    "id": "cap-077",
    "text": "触发时机、适用场景、还有边界",
    "start": 171.8,
    "end": 174.5
  },
  {
    "id": "cap-078",
    "text": "Agent 就是靠这几句判断该不该开",
    "start": 174.8,
    "end": 177.2
  },
  {
    "id": "cap-079",
    "text": "什么时候值得建一个技能",
    "start": 178.3,
    "end": 179.967
  },
  {
    "id": "cap-080",
    "text": "当你反复粘贴同一段指令",
    "start": 180.267,
    "end": 181.8
  },
  {
    "id": "cap-081",
    "text": "当一个清单越来越长",
    "start": 182.1,
    "end": 183.467
  },
  {
    "id": "cap-082",
    "text": "或者某个文档已经塞不下的时候",
    "start": 183.667,
    "end": 185.433
  },
  {
    "id": "cap-083",
    "text": "与其为每个场景单独造一个 Agent",
    "start": 186.533,
    "end": 188.767
  },
  {
    "id": "cap-084",
    "text": "不如把专长打包成能力",
    "start": 189.067,
    "end": 190.567
  },
  {
    "id": "cap-085",
    "text": "让同一个通用 Agent 长出专才的分支",
    "start": 190.833,
    "end": 193.4
  },
  {
    "id": "cap-086",
    "text": "技能有两种被用起来的方式",
    "start": 194.5,
    "end": 196.233
  },
  {
    "id": "cap-087",
    "text": "相关时自动加载",
    "start": 196.533,
    "end": 197.9
  },
  {
    "id": "cap-088",
    "text": "也可以直接点名调用",
    "start": 198.167,
    "end": 199.433
  },
  {
    "id": "cap-089",
    "text": "两种都靠那份描述兜底",
    "start": 199.7,
    "end": 201.5
  },
  {
    "id": "cap-090",
    "text": "所以技能到底是什么",
    "start": 202.6,
    "end": 204.333
  },
  {
    "id": "cap-091",
    "text": "是一份能被执行的方法论",
    "start": 204.533,
    "end": 206.2
  },
  {
    "id": "cap-092",
    "text": "也是给 Agent 的一份入职指南",
    "start": 206.4,
    "end": 208.267
  },
  {
    "id": "cap-093",
    "text": "从一个文件夹开始",
    "start": 208.5,
    "end": 209.667
  }
]
