[
  {
    "id": "cap-001",
    "text": "通用 Agent 已经能干活了",
    "start": 3.1,
    "end": 5.167
  },
  {
    "id": "cap-002",
    "text": "但一到你的领域就不够用",
    "start": 5.3,
    "end": 6.733
  },
  {
    "id": "cap-003",
    "text": "缺的不是算力，是方法",
    "start": 6.733,
    "end": 8.3
  },
  {
    "id": "cap-004",
    "text": "所以我们需要一种",
    "start": 8.4,
    "end": 9.867
  },
  {
    "id": "cap-005",
    "text": "能把专长装进去的容器",
    "start": 9.967,
    "end": 11.467
  },
  {
    "id": "cap-006",
    "text": "先给结论",
    "start": 12.567,
    "end": 13.1
  },
  {
    "id": "cap-007",
    "text": "一个技能就是一个文件夹",
    "start": 13.1,
    "end": 14.567
  },
  {
    "id": "cap-008",
    "text": "里面放着一份 SKILL.md",
    "start": 14.6,
    "end": 16.467
  },
  {
    "id": "cap-009",
    "text": "再加可选的脚本和资料",
    "start": 16.5,
    "end": 18.067
  },
  {
    "id": "cap-010",
    "text": "Agent 会在需要时自己找到它并加载",
    "start": 18.167,
    "end": 20.767
  },
  {
    "id": "cap-011",
    "text": "你可能一直在重复粘贴同一段指令",
    "start": 21.867,
    "end": 23.933
  },
  {
    "id": "cap-012",
    "text": "那是一张清单，或者一套多步流程",
    "start": 24.033,
    "end": 26.3
  },
  {
    "id": "cap-013",
    "text": "提示词用完就散了",
    "start": 26.333,
    "end": 27.667
  },
  {
    "id": "cap-014",
    "text": "技能是把它固定下来的地方",
    "start": 27.7,
    "end": 29.467
  },
  {
    "id": "cap-015",
    "text": "技能和常驻配置不一样",
    "start": 30.567,
    "end": 32
  },
  {
    "id": "cap-016",
    "text": "正文只在使用时才被读进来",
    "start": 32.1,
    "end": 34.033
  },
  {
    "id": "cap-017",
    "text": "所以再长的参考资料",
    "start": 34.1,
    "end": 35.467
  },
  {
    "id": "cap-018",
    "text": "在真正需要之前几乎不占预算",
    "start": 35.567,
    "end": 37.8
  },
  {
    "id": "cap-019",
    "text": "技能不是工具，也不是插件",
    "start": 38.9,
    "end": 40.633
  },
  {
    "id": "cap-020",
    "text": "工具给它一双手，技能给的是方法",
    "start": 40.667,
    "end": 43.2
  },
  {
    "id": "cap-021",
    "text": "技能之间还能像积木一样叠加",
    "start": 43.2,
    "end": 45.5
  },
  {
    "id": "cap-022",
    "text": "现在技能已经是一个开放标准",
    "start": 46.6,
    "end": 48.633
  },
  {
    "id": "cap-023",
    "text": "同一份格式到处都能用",
    "start": 48.767,
    "end": 50.433
  },
  {
    "id": "cap-024",
    "text": "换个平台不用重写",
    "start": 50.433,
    "end": 51.833
  },
  {
    "id": "cap-025",
    "text": "拆开看，一个技能长这样",
    "start": 53.767,
    "end": 55.267
  },
  {
    "id": "cap-026",
    "text": "根目录下一份 SKILL.md",
    "start": 55.267,
    "end": 57.1
  },
  {
    "id": "cap-027",
    "text": "旁边可以有 scripts、references、assets",
    "start": 57.1,
    "end": 58
  },
  {
    "id": "cap-028",
    "text": "只有 SKILL.md 是必需的",
    "start": 59.433,
    "end": 61.667
  },
  {
    "id": "cap-029",
    "text": "三个目录各管一件事",
    "start": 62.767,
    "end": 64.233
  },
  {
    "id": "cap-030",
    "text": "scripts 放能直接跑的代码",
    "start": 64.967,
    "end": 66.267
  },
  {
    "id": "cap-031",
    "text": "references 放沉淀下来的文档",
    "start": 67.033,
    "end": 68.3
  },
  {
    "id": "cap-032",
    "text": "assets 放模板和素材",
    "start": 68.867,
    "end": 70.033
  },
  {
    "id": "cap-033",
    "text": "SKILL.md 分成两段",
    "start": 71.133,
    "end": 72.9
  },
  {
    "id": "cap-034",
    "text": "开头是元数据，至少两项",
    "start": 72.933,
    "end": 74.933
  },
  {
    "id": "cap-035",
    "text": "名字和描述",
    "start": 74.933,
    "end": 75.7
  },
  {
    "id": "cap-036",
    "text": "下面才是写给 Agent 看的指令",
    "start": 75.733,
    "end": 77.667
  },
  {
    "id": "cap-037",
    "text": "写技能最好的心智模型",
    "start": 78.767,
    "end": 80.467
  },
  {
    "id": "cap-038",
    "text": "是给新同事写一份入职指南",
    "start": 80.567,
    "end": 82.733
  },
  {
    "id": "cap-039",
    "text": "你把踩过的坑写清楚",
    "start": 82.833,
    "end": 84.5
  },
  {
    "id": "cap-040",
    "text": "它就不用再踩一遍",
    "start": 84.6,
    "end": 85.733
  },
  {
    "id": "cap-041",
    "text": "关键在于渐进式披露",
    "start": 86.833,
    "end": 88.7
  },
  {
    "id": "cap-042",
    "text": "描述一直挂着，但很短",
    "start": 88.733,
    "end": 90.767
  },
  {
    "id": "cap-043",
    "text": "正文命中才读",
    "start": 90.433,
    "end": 91.767
  },
  {
    "id": "cap-044",
    "text": "附属文件按需再取",
    "start": 91.8,
    "end": 93.367
  },
  {
    "id": "cap-045",
    "text": "这样设计是为了省上下文",
    "start": 94.467,
    "end": 96.333
  },
  {
    "id": "cap-046",
    "text": "常驻的只有一小段描述",
    "start": 96.333,
    "end": 98.3
  },
  {
    "id": "cap-047",
    "text": "所以你能同时装很多技能",
    "start": 98.4,
    "end": 100.3
  },
  {
    "id": "cap-048",
    "text": "而不会把窗口塞满",
    "start": 100.4,
    "end": 101.7
  },
  {
    "id": "cap-049",
    "text": "那它到底怎么被用起来",
    "start": 103.633,
    "end": 104.967
  },
  {
    "id": "cap-050",
    "text": "第一步是发现",
    "start": 105.067,
    "end": 105.967
  },
  {
    "id": "cap-051",
    "text": "Agent 会扫描手上所有技能",
    "start": 106.067,
    "end": 108.333
  },
  {
    "id": "cap-052",
    "text": "找出和当前任务相关的那些",
    "start": 108.4,
    "end": 110.333
  },
  {
    "id": "cap-053",
    "text": "没有匹配就完全不碰",
    "start": 111.433,
    "end": 113.2
  },
  {
    "id": "cap-054",
    "text": "只有相关时才会访问某个技能",
    "start": 113.3,
    "end": 115.6
  },
  {
    "id": "cap-055",
    "text": "所以技能多，不等于负担重",
    "start": 115.7,
    "end": 117.233
  },
  {
    "id": "cap-056",
    "text": "命中之后",
    "start": 118.333,
    "end": 119.2
  },
  {
    "id": "cap-057",
    "text": "它只加载最小的那一部分",
    "start": 119.333,
    "end": 120.833
  },
  {
    "id": "cap-058",
    "text": "必要的说明和文件就够了",
    "start": 120.833,
    "end": 122.633
  },
  {
    "id": "cap-059",
    "text": "这样还能保持响应速度",
    "start": 122.733,
    "end": 124.3
  },
  {
    "id": "cap-060",
    "text": "技能里真正干活的是脚本",
    "start": 125.4,
    "end": 127.267
  },
  {
    "id": "cap-061",
    "text": "Agent 用本地代码执行",
    "start": 127.367,
    "end": 129.233
  },
  {
    "id": "cap-062",
    "text": "配合文件系统完成任务",
    "start": 129.333,
    "end": 130.867
  },
  {
    "id": "cap-063",
    "text": "再把结论写回来",
    "start": 130.967,
    "end": 131.967
  },
  {
    "id": "cap-064",
    "text": "再回到上下文预算这条线",
    "start": 133.067,
    "end": 135.133
  },
  {
    "id": "cap-065",
    "text": "指令和资料都不常驻",
    "start": 135.233,
    "end": 136.867
  },
  {
    "id": "cap-066",
    "text": "只有命中那一刻才付出成本",
    "start": 136.967,
    "end": 139.133
  },
  {
    "id": "cap-067",
    "text": "这是它和常驻提示词最大的区别",
    "start": 139.2,
    "end": 141.567
  },
  {
    "id": "cap-068",
    "text": "一个任务往往要用好几个技能",
    "start": 142.633,
    "end": 144.8
  },
  {
    "id": "cap-069",
    "text": "它们能叠在一起",
    "start": 144.9,
    "end": 145.867
  },
  {
    "id": "cap-070",
    "text": "Agent 自己判断需要哪些",
    "start": 145.967,
    "end": 147.967
  },
  {
    "id": "cap-071",
    "text": "再协调它们一起用",
    "start": 148,
    "end": 149
  },
  {
    "id": "cap-072",
    "text": "如果你的技能一直没被触发",
    "start": 150.933,
    "end": 152.767
  },
  {
    "id": "cap-073",
    "text": "九成是描述没写好",
    "start": 152.867,
    "end": 154.133
  },
  {
    "id": "cap-074",
    "text": "名字和描述是唯一的常驻信息",
    "start": 154.133,
    "end": 156.633
  },
  {
    "id": "cap-075",
    "text": "写得含糊，就等于不存在",
    "start": 156.733,
    "end": 158.433
  },
  {
    "id": "cap-076",
    "text": "描述里要写清楚什么时候用它",
    "start": 159.5,
    "end": 161.8
  },
  {
    "id": "cap-077",
    "text": "触发时机、适用场景、还有边界",
    "start": 161.833,
    "end": 164.333
  },
  {
    "id": "cap-078",
    "text": "Agent 就是靠这几句判断该不该开",
    "start": 164.4,
    "end": 166.9
  },
  {
    "id": "cap-079",
    "text": "什么时候值得建一个技能",
    "start": 168,
    "end": 169.7
  },
  {
    "id": "cap-080",
    "text": "当你反复粘贴同一段指令",
    "start": 169.8,
    "end": 171.367
  },
  {
    "id": "cap-081",
    "text": "当一个清单越来越长",
    "start": 171.467,
    "end": 172.833
  },
  {
    "id": "cap-082",
    "text": "或者某个文档已经塞不下的时候",
    "start": 172.933,
    "end": 174.767
  },
  {
    "id": "cap-083",
    "text": "与其为每个场景单独造一个 Agent",
    "start": 175.867,
    "end": 178.533
  },
  {
    "id": "cap-084",
    "text": "不如把专长打包成能力",
    "start": 178.633,
    "end": 180.167
  },
  {
    "id": "cap-085",
    "text": "让同一个通用 Agent 长出专才的分支",
    "start": 180.267,
    "end": 182.933
  },
  {
    "id": "cap-086",
    "text": "技能有两种被用起来的方式",
    "start": 184.033,
    "end": 185.733
  },
  {
    "id": "cap-087",
    "text": "相关时自动加载",
    "start": 185.733,
    "end": 187.167
  },
  {
    "id": "cap-088",
    "text": "也可以直接点名调用",
    "start": 187.233,
    "end": 188.733
  },
  {
    "id": "cap-089",
    "text": "两种都靠那份描述兜底",
    "start": 188.733,
    "end": 190.4
  },
  {
    "id": "cap-090",
    "text": "所以技能到底是什么",
    "start": 191.5,
    "end": 193.267
  },
  {
    "id": "cap-091",
    "text": "是一份能被执行的方法论",
    "start": 193.333,
    "end": 195
  },
  {
    "id": "cap-092",
    "text": "也是给 Agent 的一份入职指南",
    "start": 195.1,
    "end": 197.033
  },
  {
    "id": "cap-093",
    "text": "从一个文件夹开始",
    "start": 197.133,
    "end": 198.3
  }
]
