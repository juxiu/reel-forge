[
  {
    "id": "cap-001",
    "text": "一次摘要认证牵涉到的角色，比想象的多。",
    "start": 1.367,
    "end": 3.067
  },
  {
    "id": "cap-002",
    "text": "客户端、服务端、代理、时钟、缓存，缺一环就校验不过。",
    "start": 3.067,
    "end": 4.767
  },
  {
    "id": "cap-003",
    "text": "先把这张关系网摆出来。",
    "start": 4.767,
    "end": 6.467
  },
  {
    "id": "cap-004",
    "text": "报文本身是明文，头部却带着一串看不懂的字段。",
    "start": 6.967,
    "end": 8.667
  },
  {
    "id": "cap-005",
    "text": "这些字段叫摘要字段，是把口令换成不可逆的凭证。",
    "start": 8.667,
    "end": 10.367
  },
  {
    "id": "cap-006",
    "text": "换句话说，网络上看不到口令。",
    "start": 10.367,
    "end": 12.067
  },
  {
    "id": "cap-007",
    "text": "并不是每套系统都值得上摘要。",
    "start": 12.567,
    "end": 14.267
  },
  {
    "id": "cap-008",
    "text": "公网链路该上，内网链路可以省。",
    "start": 14.267,
    "end": 15.967
  },
  {
    "id": "cap-009",
    "text": "差别在于链路上有没有不可信的跳。",
    "start": 15.967,
    "end": 17.667
  },
  {
    "id": "cap-010",
    "text": "摘要不是凭空来的，它由四个部分拼成。",
    "start": 18.167,
    "end": 19.867
  },
  {
    "id": "cap-011",
    "text": "算法、字段顺序、规范化方式、拼接顺序，缺一不可。",
    "start": 19.867,
    "end": 21.567
  },
  {
    "id": "cap-012",
    "text": "任何一处不同，两侧算出的摘要就不一样。",
    "start": 21.567,
    "end": 23.267
  },
  {
    "id": "cap-013",
    "text": "覆盖一跳还是覆盖整条链，是两种设计。",
    "start": 23.767,
    "end": 25.467
  },
  {
    "id": "cap-014",
    "text": "单跳校验便宜，但代理能读到原文。",
    "start": 25.467,
    "end": 27.167
  },
  {
    "id": "cap-015",
    "text": "端到端贵一些，整条链路都不可读。",
    "start": 27.167,
    "end": 28.867
  },
  {
    "id": "cap-016",
    "text": "于是报文被压成一个固定长度的摘要。",
    "start": 29.367,
    "end": 31.067
  },
  {
    "id": "cap-017",
    "text": "服务器只拿摘要比对，口令始终不出网关。",
    "start": 31.067,
    "end": 32.767
  },
  {
    "id": "cap-018",
    "text": "这是摘要机制最核心的一次转换。",
    "start": 32.767,
    "end": 34.467
  },
  {
    "id": "cap-019",
    "text": "摘要认证要走完三步。",
    "start": 34.967,
    "end": 36.667
  },
  {
    "id": "cap-020",
    "text": "服务端先发挑战，客户端算摘要回应，服务端比对。",
    "start": 36.667,
    "end": 38.367
  },
  {
    "id": "cap-021",
    "text": "少任何一步都算不上一次认证。",
    "start": 38.367,
    "end": 40.067
  },
  {
    "id": "cap-022",
    "text": "为什么不用明文口令？",
    "start": 40.567,
    "end": 42.267
  },
  {
    "id": "cap-023",
    "text": "抓包就能读到，代理和日志都会留一份。",
    "start": 42.267,
    "end": 43.967
  },
  {
    "id": "cap-024",
    "text": "同一份凭据还能被反复重放。",
    "start": 43.967,
    "end": 45.667
  },
  {
    "id": "cap-025",
    "text": "摘要认证不是新发明，它是 HTTP 里的一项可选机制。",
    "start": 46.167,
    "end": 47.867
  },
  {
    "id": "cap-026",
    "text": "规范定义了字段、算法和拼接方式。",
    "start": 47.867,
    "end": 49.567
  },
  {
    "id": "cap-027",
    "text": "我们按规范里的例子来讲。",
    "start": 49.567,
    "end": 51.267
  },
  {
    "id": "cap-028",
    "text": "客户端真正发出去的，就是这一行头。",
    "start": 51.767,
    "end": 53.467
  },
  {
    "id": "cap-029",
    "text": "用户名、域、路径、还有一串计数器。",
    "start": 53.467,
    "end": 55.167
  },
  {
    "id": "cap-030",
    "text": "这些字段拼起来，才得到最终的摘要。",
    "start": 55.167,
    "end": 56.867
  },
  {
    "id": "cap-031",
    "text": "一次请求牵涉的角色可以列成一圈。",
    "start": 57.367,
    "end": 59.067
  },
  {
    "id": "cap-032",
    "text": "客户端负责算，服务端负责比。",
    "start": 59.067,
    "end": 60.767
  },
  {
    "id": "cap-033",
    "text": "代理、缓存、日志各取所需。",
    "start": 60.767,
    "end": 62.467
  },
  {
    "id": "cap-034",
    "text": "职责天然落在两侧。",
    "start": 62.967,
    "end": 64.667
  },
  {
    "id": "cap-035",
    "text": "客户端算摘要，服务端生成挑战并比对。",
    "start": 64.667,
    "end": 66.367
  },
  {
    "id": "cap-036",
    "text": "两边共享的只有那把密钥。",
    "start": 66.367,
    "end": 68.067
  },
  {
    "id": "cap-037",
    "text": "算法分三档，按需选。",
    "start": 70.067,
    "end": 71.767
  },
  {
    "id": "cap-038",
    "text": "弱摘要容易撞，强摘要成本高。",
    "start": 71.767,
    "end": 73.467
  },
  {
    "id": "cap-039",
    "text": "多数新系统直接从第三档起步。",
    "start": 73.467,
    "end": 75.167
  },
  {
    "id": "cap-040",
    "text": "摘要值来自四层东西。",
    "start": 75.667,
    "end": 77.367
  },
  {
    "id": "cap-041",
    "text": "先定算法，再定字段顺序，然后规范化和拼接。",
    "start": 77.367,
    "end": 79.067
  },
  {
    "id": "cap-042",
    "text": "顺序一旦定错，摘要必然不等。",
    "start": 79.067,
    "end": 80.767
  },
  {
    "id": "cap-043",
    "text": "新旧写法逐项对照，差别不小。",
    "start": 81.267,
    "end": 82.967
  },
  {
    "id": "cap-044",
    "text": "旧写法里算法是缺省的，新写法必须写明。",
    "start": 82.967,
    "end": 84.667
  },
  {
    "id": "cap-045",
    "text": "用户名是否进摘要也换了约定。",
    "start": 84.667,
    "end": 86.367
  },
  {
    "id": "cap-046",
    "text": "口令本身不会离开客户端。",
    "start": 86.867,
    "end": 88.567
  },
  {
    "id": "cap-047",
    "text": "它先被压成摘要，再进网。",
    "start": 88.567,
    "end": 90.267
  },
  {
    "id": "cap-048",
    "text": "服务器只见到摘要这一种形态。",
    "start": 90.267,
    "end": 91.967
  },
  {
    "id": "cap-049",
    "text": "强度可以分三档看。",
    "start": 92.467,
    "end": 94.167
  },
  {
    "id": "cap-050",
    "text": "不加密、弱摘要、强摘要。",
    "start": 94.167,
    "end": 95.867
  },
  {
    "id": "cap-051",
    "text": "公网场景基本只考虑第三档。",
    "start": 95.867,
    "end": 97.567
  },
  {
    "id": "cap-052",
    "text": "弱算法被淘汰是有原因的。",
    "start": 98.067,
    "end": 99.767
  },
  {
    "id": "cap-053",
    "text": "摘要长度有限，可以被穷举。",
    "start": 99.767,
    "end": 101.467
  },
  {
    "id": "cap-054",
    "text": "碰撞也更容易被构造出来。",
    "start": 101.467,
    "end": 103.167
  },
  {
    "id": "cap-055",
    "text": "拼接顺序必须是双方约定的。",
    "start": 103.667,
    "end": 105.367
  },
  {
    "id": "cap-056",
    "text": "规范给出了规范串的定义。",
    "start": 105.367,
    "end": 107.067
  },
  {
    "id": "cap-057",
    "text": "顺序错了，摘要就对不上。",
    "start": 107.067,
    "end": 108.767
  },
  {
    "id": "cap-058",
    "text": "规范化之后，请求变成四段。",
    "start": 109.267,
    "end": 110.967
  },
  {
    "id": "cap-059",
    "text": "方法、路径、认证参数、摘要前缀。",
    "start": 110.967,
    "end": 112.667
  },
  {
    "id": "cap-060",
    "text": "它们按固定顺序排好，再拼起来。",
    "start": 112.667,
    "end": 114.367
  },
  {
    "id": "cap-061",
    "text": "谁有权定义这个顺序？",
    "start": 114.867,
    "end": 116.567
  },
  {
    "id": "cap-062",
    "text": "规范说了算，客户端和服务端都照它执行。",
    "start": 116.567,
    "end": 118.267
  },
  {
    "id": "cap-063",
    "text": "测试向量用来保证两边一致。",
    "start": 118.267,
    "end": 119.967
  },
  {
    "id": "cap-064",
    "text": "请求侧和响应侧的字段不一样。",
    "start": 120.467,
    "end": 122.167
  },
  {
    "id": "cap-065",
    "text": "请求侧关心方法和路径。",
    "start": 122.167,
    "end": 123.867
  },
  {
    "id": "cap-066",
    "text": "响应侧关心摘要本身和随机串。",
    "start": 123.867,
    "end": 125.567
  },
  {
    "id": "cap-067",
    "text": "顺序有三种取法。",
    "start": 126.067,
    "end": 127.767
  },
  {
    "id": "cap-068",
    "text": "手写固定序、按字典序、按规范序。",
    "start": 127.767,
    "end": 129.467
  },
  {
    "id": "cap-069",
    "text": "新系统应该走第三种。",
    "start": 129.467,
    "end": 131.167
  },
  {
    "id": "cap-070",
    "text": "字段本身也分四层。",
    "start": 131.667,
    "end": 133.367
  },
  {
    "id": "cap-071",
    "text": "原始头字段先规范化，再拼接，最后摘要。",
    "start": 133.367,
    "end": 135.067
  },
  {
    "id": "cap-072",
    "text": "每一层都可能出错。",
    "start": 135.067,
    "end": 136.767
  },
  {
    "id": "cap-073",
    "text": "有没有计数器，差别很大。",
    "start": 138.767,
    "end": 140.467
  },
  {
    "id": "cap-074",
    "text": "没有计数器，原样重放就能通过。",
    "start": 140.467,
    "end": 142.167
  },
  {
    "id": "cap-075",
    "text": "有了计数器，序号必须递增。",
    "start": 142.167,
    "end": 143.867
  },
  {
    "id": "cap-076",
    "text": "重放被压进一个窗口里。",
    "start": 144.367,
    "end": 146.067
  },
  {
    "id": "cap-077",
    "text": "报文进来，先看序号是否用过。",
    "start": 146.067,
    "end": 147.767
  },
  {
    "id": "cap-078",
    "text": "用过就直接拒绝。",
    "start": 147.767,
    "end": 149.467
  },
  {
    "id": "cap-079",
    "text": "重放防护同样分三档。",
    "start": 149.967,
    "end": 151.667
  },
  {
    "id": "cap-080",
    "text": "只有随机串最弱，加上计数就好些。",
    "start": 151.667,
    "end": 153.367
  },
  {
    "id": "cap-081",
    "text": "再加时间窗口才算稳。",
    "start": 153.367,
    "end": 155.067
  },
  {
    "id": "cap-082",
    "text": "时钟偏了就会失败。",
    "start": 155.567,
    "end": 157.267
  },
  {
    "id": "cap-083",
    "text": "客户端快了一点，服务端就判过期。",
    "start": 157.267,
    "end": 158.967
  },
  {
    "id": "cap-084",
    "text": "请求直接被拒，没有补救机会。",
    "start": 158.967,
    "end": 160.667
  },
  {
    "id": "cap-085",
    "text": "规范对时钟有明确要求。",
    "start": 161.167,
    "end": 162.867
  },
  {
    "id": "cap-086",
    "text": "两侧时间必须足够接近。",
    "start": 162.867,
    "end": 164.567
  },
  {
    "id": "cap-087",
    "text": "偏差过大会被当成异常。",
    "start": 164.567,
    "end": 166.267
  },
  {
    "id": "cap-088",
    "text": "每次请求都要变的东西有三个。",
    "start": 166.767,
    "end": 168.467
  },
  {
    "id": "cap-089",
    "text": "计数器自增，随机串重算，质量参数固定。",
    "start": 168.467,
    "end": 170.167
  },
  {
    "id": "cap-090",
    "text": "这三个字段是防重放的关键。",
    "start": 170.167,
    "end": 171.867
  },
  {
    "id": "cap-091",
    "text": "有代理的时候，链路会变长。",
    "start": 172.367,
    "end": 174.067
  },
  {
    "id": "cap-092",
    "text": "每一跳都可能看到明文。",
    "start": 174.067,
    "end": 175.767
  },
  {
    "id": "cap-093",
    "text": "缓存和日志还会各自留一份。",
    "start": 175.767,
    "end": 177.467
  },
  {
    "id": "cap-094",
    "text": "于是有了逐跳和端到端两种做法。",
    "start": 177.967,
    "end": 179.667
  },
  {
    "id": "cap-095",
    "text": "逐跳便宜，但只覆盖一段。",
    "start": 179.667,
    "end": 181.367
  },
  {
    "id": "cap-096",
    "text": "端到端贵，覆盖整条链。",
    "start": 181.367,
    "end": 183.067
  },
  {
    "id": "cap-097",
    "text": "部署方式常见三种。",
    "start": 183.567,
    "end": 185.267
  },
  {
    "id": "cap-098",
    "text": "全链摘要最彻底，也最贵。",
    "start": 185.267,
    "end": 186.967
  },
  {
    "id": "cap-099",
    "text": "逐跳摘要是折中，边缘摘要介于两者之间。",
    "start": 186.967,
    "end": 188.667
  },
  {
    "id": "cap-100",
    "text": "每一跳要做四件事。",
    "start": 189.167,
    "end": 190.867
  },
  {
    "id": "cap-101",
    "text": "先认证，再转发，然后重新认证，最后落库。",
    "start": 190.867,
    "end": 192.567
  },
  {
    "id": "cap-102",
    "text": "任何一跳漏掉都会断链。",
    "start": 192.567,
    "end": 194.267
  },
  {
    "id": "cap-103",
    "text": "覆盖范围的差别不在算法。",
    "start": 194.767,
    "end": 196.467
  },
  {
    "id": "cap-104",
    "text": "在链路长度。",
    "start": 196.467,
    "end": 198.167
  },
  {
    "id": "cap-105",
    "text": "一跳和整条链是两个量级。",
    "start": 198.167,
    "end": 199.867
  },
  {
    "id": "cap-106",
    "text": "密钥也随 hops 拆开。",
    "start": 200.367,
    "end": 202.067
  },
  {
    "id": "cap-107",
    "text": "共享密钥变成每跳一把。",
    "start": 202.067,
    "end": 203.767
  },
  {
    "id": "cap-108",
    "text": "好处是任何一把都能单独撤回。",
    "start": 203.767,
    "end": 205.467
  },
  {
    "id": "cap-109",
    "text": "真正接入要改三处。",
    "start": 207.467,
    "end": 209.167
  },
  {
    "id": "cap-110",
    "text": "选算法、配字段、对齐顺序。",
    "start": 209.167,
    "end": 210.867
  },
  {
    "id": "cap-111",
    "text": "顺序那一步最容易被漏掉。",
    "start": 210.867,
    "end": 212.567
  },
  {
    "id": "cap-112",
    "text": "代价也是从这三处来的。",
    "start": 213.067,
    "end": 214.767
  },
  {
    "id": "cap-113",
    "text": "每跳多算一次，两侧顺序要对齐。",
    "start": 214.767,
    "end": 216.467
  },
  {
    "id": "cap-114",
    "text": "调试成本明显上升。",
    "start": 216.467,
    "end": 218.167
  },
  {
    "id": "cap-115",
    "text": "但要先记住一件事。",
    "start": 218.667,
    "end": 220.367
  },
  {
    "id": "cap-116",
    "text": "摘要是可选机制，不开就没有这些代价。",
    "start": 220.367,
    "end": 222.067
  },
  {
    "id": "cap-117",
    "text": "代价集中在顺序和时钟上。",
    "start": 222.067,
    "end": 223.767
  },
  {
    "id": "cap-118",
    "text": "落到配置上就是这几行。",
    "start": 224.267,
    "end": 225.967
  },
  {
    "id": "cap-119",
    "text": "算法写明，质量参数写明，计数器每次自增。",
    "start": 225.967,
    "end": 227.667
  },
  {
    "id": "cap-120",
    "text": "顺序仍然要对齐。",
    "start": 227.667,
    "end": 229.367
  },
  {
    "id": "cap-121",
    "text": "落地会碰到四个组件。",
    "start": 229.867,
    "end": 231.567
  },
  {
    "id": "cap-122",
    "text": "网关、应用、客户端，还有运维。",
    "start": 231.567,
    "end": 233.267
  },
  {
    "id": "cap-123",
    "text": "每一个都要改。",
    "start": 233.267,
    "end": 234.967
  },
  {
    "id": "cap-124",
    "text": "代价最终落在两侧。",
    "start": 235.467,
    "end": 237.167
  },
  {
    "id": "cap-125",
    "text": "客户端多存一次摘要。",
    "start": 237.167,
    "end": 238.867
  },
  {
    "id": "cap-126",
    "text": "服务端多算一次摘要。",
    "start": 238.867,
    "end": 240.567
  },
  {
