[
  {
    "id": "cap-001",
    "text": "一次摘要认证牵涉到的角色",
    "start": 3.1,
    "end": 5.1
  },
  {
    "id": "cap-002",
    "text": "比想象的多。",
    "start": 5.2,
    "end": 5.9
  },
  {
    "id": "cap-003",
    "text": "客户端、服务端、代理、时钟、缓存",
    "start": 5.9,
    "end": 7.767
  },
  {
    "id": "cap-004",
    "text": "缺一环就校验不过。",
    "start": 7.8,
    "end": 9.133
  },
  {
    "id": "cap-005",
    "text": "先把这张关系网摆出来。",
    "start": 9.133,
    "end": 10.767
  },
  {
    "id": "cap-006",
    "text": "报文本身是明文",
    "start": 11.867,
    "end": 13.467
  },
  {
    "id": "cap-007",
    "text": "头部却带着一串看不懂的字段。",
    "start": 12.7,
    "end": 15.267
  },
  {
    "id": "cap-008",
    "text": "这些字段叫摘要字段",
    "start": 15.367,
    "end": 17.2
  },
  {
    "id": "cap-009",
    "text": "是把口令换成不可逆的凭证。",
    "start": 17.3,
    "end": 19.2
  },
  {
    "id": "cap-010",
    "text": "换句话说，网络上看不到口令。",
    "start": 19.3,
    "end": 21.533
  },
  {
    "id": "cap-011",
    "text": "并不是每套系统都值得上摘要。",
    "start": 22.633,
    "end": 24.533
  },
  {
    "id": "cap-012",
    "text": "公网链路该上，内网链路可以省。",
    "start": 24.533,
    "end": 26.767
  },
  {
    "id": "cap-013",
    "text": "差别在于链路上有没有不可信的跳。",
    "start": 26.767,
    "end": 28.9
  },
  {
    "id": "cap-014",
    "text": "摘要不是凭空来的，它由四个部分拼成。",
    "start": 30,
    "end": 32.867
  },
  {
    "id": "cap-015",
    "text": "算法、字段顺序、规范化方式、拼接顺序",
    "start": 32.9,
    "end": 35.667
  },
  {
    "id": "cap-016",
    "text": "缺一不可。",
    "start": 35.767,
    "end": 36.433
  },
  {
    "id": "cap-017",
    "text": "任何一处不同",
    "start": 36.433,
    "end": 37.333
  },
  {
    "id": "cap-018",
    "text": "两侧算出的摘要就不一样。",
    "start": 37.333,
    "end": 38.9
  },
  {
    "id": "cap-019",
    "text": "覆盖一跳还是覆盖整条链，是两种设计。",
    "start": 40,
    "end": 42.967
  },
  {
    "id": "cap-020",
    "text": "单跳校验便宜，但代理能读到原文。",
    "start": 42.967,
    "end": 45.367
  },
  {
    "id": "cap-021",
    "text": "端到端贵一些，整条链路都不可读。",
    "start": 45.367,
    "end": 47.567
  },
  {
    "id": "cap-022",
    "text": "于是报文被压成一个固定长度的摘要。",
    "start": 48.667,
    "end": 51.4
  },
  {
    "id": "cap-023",
    "text": "服务器只拿摘要比对",
    "start": 51.4,
    "end": 52.867
  },
  {
    "id": "cap-024",
    "text": "口令始终不出网关。",
    "start": 52.9,
    "end": 54.6
  },
  {
    "id": "cap-025",
    "text": "这是摘要机制最核心的一次转换。",
    "start": 54.7,
    "end": 56.6
  },
  {
    "id": "cap-026",
    "text": "摘要认证要走完三步。",
    "start": 57.7,
    "end": 59.067
  },
  {
    "id": "cap-027",
    "text": "服务端先发挑战",
    "start": 59.167,
    "end": 60.4
  },
  {
    "id": "cap-028",
    "text": "客户端算摘要回应，服务端比对。",
    "start": 60.4,
    "end": 62.933
  },
  {
    "id": "cap-029",
    "text": "少任何一步都算不上一次认证。",
    "start": 62.967,
    "end": 64.833
  },
  {
    "id": "cap-030",
    "text": "为什么不用明文口令？",
    "start": 65.933,
    "end": 66.967
  },
  {
    "id": "cap-031",
    "text": "抓包就能读到，代理和日志都会留一份。",
    "start": 66.967,
    "end": 69.6
  },
  {
    "id": "cap-032",
    "text": "同一份凭据还能被反复重放。",
    "start": 69.633,
    "end": 71.7
  },
  {
    "id": "cap-033",
    "text": "摘要认证不是新发明",
    "start": 72.8,
    "end": 74.467
  },
  {
    "id": "cap-034",
    "text": "它是 HTTP 里的一项可选机制。",
    "start": 74.567,
    "end": 77.3
  },
  {
    "id": "cap-035",
    "text": "规范定义了字段、算法和拼接方式。",
    "start": 77.4,
    "end": 79.933
  },
  {
    "id": "cap-036",
    "text": "我们按规范里的例子来讲。",
    "start": 80.033,
    "end": 81.533
  },
  {
    "id": "cap-037",
    "text": "客户端真正发出去的，就是这一行头。",
    "start": 82.6,
    "end": 85.467
  },
  {
    "id": "cap-038",
    "text": "用户名、域、路径、还有一串计数器。",
    "start": 85.5,
    "end": 87.567
  },
  {
    "id": "cap-039",
    "text": "这些字段拼起来，才得到最终的摘要。",
    "start": 87.6,
    "end": 90
  },
  {
    "id": "cap-040",
    "text": "一次请求牵涉的角色可以列成一圈。",
    "start": 91.1,
    "end": 93.367
  },
  {
    "id": "cap-041",
    "text": "客户端负责算，服务端负责比。",
    "start": 93.367,
    "end": 95.167
  },
  {
    "id": "cap-042",
    "text": "代理、缓存、日志各取所需。",
    "start": 95.2,
    "end": 97.067
  },
  {
    "id": "cap-043",
    "text": "职责天然落在两侧。",
    "start": 98.167,
    "end": 99.333
  },
  {
    "id": "cap-044",
    "text": "客户端算摘要，服务端生成挑战并比对。",
    "start": 99.333,
    "end": 102.533
  },
  {
    "id": "cap-045",
    "text": "两边共享的只有那把密钥。",
    "start": 102.567,
    "end": 104.333
  },
  {
    "id": "cap-046",
    "text": "算法分三档，按需选。",
    "start": 106.267,
    "end": 108.033
  },
  {
    "id": "cap-047",
    "text": "弱摘要容易撞，强摘要成本高。",
    "start": 107.767,
    "end": 110.333
  },
  {
    "id": "cap-048",
    "text": "多数新系统直接从第三档起步。",
    "start": 110.433,
    "end": 112.833
  },
  {
    "id": "cap-049",
    "text": "摘要值来自四层东西。",
    "start": 113.933,
    "end": 115.533
  },
  {
    "id": "cap-050",
    "text": "先定算法",
    "start": 115.633,
    "end": 116.5
  },
  {
    "id": "cap-051",
    "text": "再定字段顺序，然后规范化和拼接。",
    "start": 116.6,
    "end": 119.233
  },
  {
    "id": "cap-052",
    "text": "顺序一旦定错，摘要必然不等。",
    "start": 119.233,
    "end": 121.767
  },
  {
    "id": "cap-053",
    "text": "新旧写法逐项对照，差别不小。",
    "start": 122.867,
    "end": 125.267
  },
  {
    "id": "cap-054",
    "text": "旧写法里算法是缺省的",
    "start": 125,
    "end": 126.767
  },
  {
    "id": "cap-055",
    "text": "新写法必须写明。",
    "start": 126.767,
    "end": 128.2
  },
  {
    "id": "cap-056",
    "text": "用户名是否进摘要也换了约定。",
    "start": 128.2,
    "end": 130.3
  },
  {
    "id": "cap-057",
    "text": "口令本身不会离开客户端。",
    "start": 131.4,
    "end": 133.133
  },
  {
    "id": "cap-058",
    "text": "它先被压成摘要，再进网。",
    "start": 133.133,
    "end": 134.9
  },
  {
    "id": "cap-059",
    "text": "服务器只见到摘要这一种形态。",
    "start": 134.9,
    "end": 136.9
  },
  {
    "id": "cap-060",
    "text": "强度可以分三档看。",
    "start": 138,
    "end": 139.567
  },
  {
    "id": "cap-061",
    "text": "不加密、弱摘要、强摘要。",
    "start": 139.567,
    "end": 141.267
  },
  {
    "id": "cap-062",
    "text": "公网场景基本只考虑第三档。",
    "start": 141.333,
    "end": 143.433
  },
  {
    "id": "cap-063",
    "text": "弱算法被淘汰是有原因的。",
    "start": 144.533,
    "end": 146.8
  },
  {
    "id": "cap-064",
    "text": "摘要长度有限，可以被穷举。",
    "start": 146.9,
    "end": 148.9
  },
  {
    "id": "cap-065",
    "text": "碰撞也更容易被构造出来。",
    "start": 148.9,
    "end": 150.667
  },
  {
    "id": "cap-066",
    "text": "拼接顺序必须是双方约定的。",
    "start": 151.767,
    "end": 153.767
  },
  {
    "id": "cap-067",
    "text": "规范给出了规范串的定义。",
    "start": 153.767,
    "end": 155.567
  },
  {
    "id": "cap-068",
    "text": "顺序错了，摘要就对不上。",
    "start": 155.6,
    "end": 157.433
  },
  {
    "id": "cap-069",
    "text": "规范化之后，请求变成四段。",
    "start": 158.533,
    "end": 160.7
  },
  {
    "id": "cap-070",
    "text": "方法、路径、认证参数、摘要前缀。",
    "start": 160.7,
    "end": 163.133
  },
  {
    "id": "cap-071",
    "text": "它们按固定顺序排好，再拼起来。",
    "start": 163.233,
    "end": 165.6
  },
  {
    "id": "cap-072",
    "text": "谁有权定义这个顺序？",
    "start": 166.7,
    "end": 167.967
  },
  {
    "id": "cap-073",
    "text": "规范说了算",
    "start": 168,
    "end": 168.833
  },
  {
    "id": "cap-074",
    "text": "客户端和服务端都照它执行。",
    "start": 168.933,
    "end": 171.033
  },
  {
    "id": "cap-075",
    "text": "测试向量用来保证两边一致。",
    "start": 171.033,
    "end": 172.9
  },
  {
    "id": "cap-076",
    "text": "请求侧和响应侧的字段不一样。",
    "start": 174,
    "end": 176
  },
  {
    "id": "cap-077",
    "text": "请求侧关心方法和路径。",
    "start": 176.1,
    "end": 177.9
  },
  {
    "id": "cap-078",
    "text": "响应侧关心摘要本身和随机串。",
    "start": 177.933,
    "end": 180.267
  },
  {
    "id": "cap-079",
    "text": "顺序有三种取法。",
    "start": 181.367,
    "end": 182.767
  },
  {
    "id": "cap-080",
    "text": "手写固定序、按字典序、按规范序。",
    "start": 182.867,
    "end": 185.9
  },
  {
    "id": "cap-081",
    "text": "新系统应该走第三种。",
    "start": 185.533,
    "end": 187.233
  },
  {
    "id": "cap-082",
    "text": "字段本身也分四层。",
    "start": 188.333,
    "end": 189.833
  },
  {
    "id": "cap-083",
    "text": "原始头字段先规范化，再拼接，最后摘要。",
    "start": 189.867,
    "end": 192.667
  },
  {
    "id": "cap-084",
    "text": "每一层都可能出错。",
    "start": 192.7,
    "end": 193.867
  },
  {
    "id": "cap-085",
    "text": "有没有计数器，差别很大。",
    "start": 195.8,
    "end": 197.333
  },
  {
    "id": "cap-086",
    "text": "没有计数器，原样重放就能通过。",
    "start": 197.433,
    "end": 199.567
  },
  {
    "id": "cap-087",
    "text": "有了计数器，序号必须递增。",
    "start": 199.667,
    "end": 201.467
  },
  {
    "id": "cap-088",
    "text": "重放被压进一个窗口里。",
    "start": 202.567,
    "end": 204.133
  },
  {
    "id": "cap-089",
    "text": "报文进来，先看序号是否用过。",
    "start": 204.267,
    "end": 206.533
  },
  {
    "id": "cap-090",
    "text": "用过就直接拒绝。",
    "start": 206.533,
    "end": 207.967
  },
  {
    "id": "cap-091",
    "text": "重放防护同样分三档。",
    "start": 209.067,
    "end": 211.067
  },
  {
    "id": "cap-092",
    "text": "只有随机串最弱，加上计数就好些。",
    "start": 211.167,
    "end": 213.833
  },
  {
    "id": "cap-093",
    "text": "再加时间窗口才算稳。",
    "start": 213.933,
    "end": 215.6
  },
  {
    "id": "cap-094",
    "text": "时钟偏了就会失败。",
    "start": 216.7,
    "end": 218.267
  },
  {
    "id": "cap-095",
    "text": "客户端快了一点，服务端就判过期。",
    "start": 218.367,
    "end": 220.6
  },
  {
    "id": "cap-096",
    "text": "请求直接被拒，没有补救机会。",
    "start": 220.6,
    "end": 222.667
  },
  {
    "id": "cap-097",
    "text": "规范对时钟有明确要求。",
    "start": 223.767,
    "end": 225.7
  },
  {
    "id": "cap-098",
    "text": "两侧时间必须足够接近。",
    "start": 225.8,
    "end": 227.533
  },
  {
    "id": "cap-099",
    "text": "偏差过大会被当成异常。",
    "start": 227.567,
    "end": 229.367
  },
  {
    "id": "cap-100",
    "text": "每次请求都要变的东西有三个。",
    "start": 230.467,
    "end": 232.567
  },
  {
    "id": "cap-101",
    "text": "计数器自增，随机串重算，质量参数固定。",
    "start": 232.6,
    "end": 235.7
  },
  {
    "id": "cap-102",
    "text": "这三个字段是防重放的关键。",
    "start": 235.767,
    "end": 237.8
  },
  {
    "id": "cap-103",
    "text": "有代理的时候，链路会变长。",
    "start": 238.9,
    "end": 241
  },
  {
    "id": "cap-104",
    "text": "每一跳都可能看到明文。",
    "start": 241.1,
    "end": 242.933
  },
  {
    "id": "cap-105",
    "text": "缓存和日志还会各自留一份。",
    "start": 242.933,
    "end": 245.133
  },
  {
    "id": "cap-106",
    "text": "于是有了逐跳和端到端两种做法。",
    "start": 246.2,
    "end": 248.967
  },
  {
    "id": "cap-107",
    "text": "逐跳便宜，但只覆盖一段。",
    "start": 249.067,
    "end": 250.933
  },
  {
    "id": "cap-108",
    "text": "端到端贵，覆盖整条链。",
    "start": 250.967,
    "end": 252.533
  },
  {
    "id": "cap-109",
    "text": "部署方式常见三种。",
    "start": 253.633,
    "end": 255.333
  },
  {
    "id": "cap-110",
    "text": "全链摘要最彻底，也最贵。",
    "start": 255.367,
    "end": 257.467
  },
  {
    "id": "cap-111",
    "text": "逐跳摘要是折中",
    "start": 257.467,
    "end": 258.867
  },
  {
    "id": "cap-112",
    "text": "边缘摘要介于两者之间。",
    "start": 258.9,
    "end": 260.767
  },
  {
    "id": "cap-113",
    "text": "每一跳要做四件事。",
    "start": 261.867,
    "end": 263.367
  },
  {
    "id": "cap-114",
    "text": "先认证，再转发，然后重新认证，最后落库。",
    "start": 263.033,
    "end": 266.467
  },
  {
    "id": "cap-115",
    "text": "任何一跳漏掉都会断链。",
    "start": 266.567,
    "end": 268.267
  },
  {
    "id": "cap-116",
    "text": "覆盖范围的差别不在算法。",
    "start": 269.367,
    "end": 271.367
  },
  {
    "id": "cap-117",
    "text": "在链路长度。",
    "start": 271.467,
    "end": 272.267
  },
  {
    "id": "cap-118",
    "text": "一跳和整条链是两个量级。",
    "start": 272.267,
    "end": 274.367
  },
  {
    "id": "cap-119",
    "text": "密钥也随 hops 拆开。",
    "start": 275.467,
    "end": 277.1
  },
  {
    "id": "cap-120",
    "text": "共享密钥变成每跳一把。",
    "start": 277.1,
    "end": 278.867
  },
  {
    "id": "cap-121",
    "text": "好处是任何一把都能单独撤回。",
    "start": 278.967,
    "end": 281.567
  },
  {
    "id": "cap-122",
    "text": "真正接入要改三处。",
    "start": 283.5,
    "end": 285.1
  },
  {
    "id": "cap-123",
    "text": "选算法、配字段、对齐顺序。",
    "start": 285.133,
    "end": 286.933
  },
  {
    "id": "cap-124",
    "text": "顺序那一步最容易被漏掉。",
    "start": 286.933,
    "end": 288.8
  },
  {
    "id": "cap-125",
    "text": "代价也是从这三处来的。",
    "start": 289.9,
    "end": 291.6
  },
  {
    "id": "cap-126",
    "text": "每跳多算一次，两侧顺序要对齐。",
    "start": 291.7,
    "end": 294.4
  },
  {
    "id": "cap-127",
    "text": "调试成本明显上升。",
    "start": 294.4,
    "end": 295.833
  },
  {
    "id": "cap-128",
    "text": "但要先记住一件事。",
    "start": 296.933,
    "end": 298.167
  },
  {
    "id": "cap-129",
    "text": "摘要是可选机制，不开就没有这些代价。",
    "start": 298.267,
    "end": 300.9
  },
  {
    "id": "cap-130",
    "text": "代价集中在顺序和时钟上。",
    "start": 300.9,
