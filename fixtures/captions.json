[
  {
    "id": "cap-001",
    "text": "一次摘要认证牵涉到的角色，比想象的多。",
    "start": 1.6,
    "end": 4.733
  },
  {
    "id": "cap-002",
    "text": "客户端、服务端、代理、时钟、缓存，缺一环就校验不过。",
    "start": 5.267,
    "end": 11.233
  },
  {
    "id": "cap-003",
    "text": "先把这张关系网摆出来。",
    "start": 11.8,
    "end": 13.833
  },
  {
    "id": "cap-004",
    "text": "报文本身是明文，头部却带着一串看不懂的字段。",
    "start": 14.933,
    "end": 18.7
  },
  {
    "id": "cap-005",
    "text": "这些字段叫摘要字段，是把口令换成不可逆的凭证。",
    "start": 19.3,
    "end": 23.6
  },
  {
    "id": "cap-006",
    "text": "换句话说，网络上看不到口令。",
    "start": 24.167,
    "end": 26.667
  },
  {
    "id": "cap-007",
    "text": "并不是每套系统都值得上摘要。",
    "start": 27.767,
    "end": 30.133
  },
  {
    "id": "cap-008",
    "text": "公网链路该上，内网链路可以省。",
    "start": 30.7,
    "end": 33.267
  },
  {
    "id": "cap-009",
    "text": "差别在于链路上有没有不可信的跳。",
    "start": 33.8,
    "end": 36.7
  },
  {
    "id": "cap-010",
    "text": "摘要不是凭空来的，它由四个部分拼成。",
    "start": 37.8,
    "end": 40.9
  },
  {
    "id": "cap-011",
    "text": "算法、字段顺序、规范化方式、拼接顺序，缺一不可。",
    "start": 41.467,
    "end": 46.633
  },
  {
    "id": "cap-012",
    "text": "任何一处不同，两侧算出的摘要就不一样。",
    "start": 47.2,
    "end": 50.467
  },
  {
    "id": "cap-013",
    "text": "覆盖一跳还是覆盖整条链，是两种设计。",
    "start": 51.567,
    "end": 55.267
  },
  {
    "id": "cap-014",
    "text": "单跳校验便宜，但代理能读到原文。",
    "start": 55.833,
    "end": 58.8
  },
  {
    "id": "cap-015",
    "text": "端到端贵一些，整条链路都不可读。",
    "start": 59.4,
    "end": 62.3
  },
  {
    "id": "cap-016",
    "text": "于是报文被压成一个固定长度的摘要。",
    "start": 63.4,
    "end": 66.333
  },
  {
    "id": "cap-017",
    "text": "服务器只拿摘要比对，口令始终不出网关。",
    "start": 66.9,
    "end": 70.4
  },
  {
    "id": "cap-018",
    "text": "这是摘要机制最核心的一次转换。",
    "start": 71,
    "end": 73.233
  },
  {
    "id": "cap-019",
    "text": "摘要认证要走完三步。",
    "start": 74.333,
    "end": 76.1
  },
  {
    "id": "cap-020",
    "text": "服务端先发挑战，客户端算摘要回应，服务端比对。",
    "start": 76.633,
    "end": 80.933
  },
  {
    "id": "cap-021",
    "text": "少任何一步都算不上一次认证。",
    "start": 81.5,
    "end": 83.8
  },
  {
    "id": "cap-022",
    "text": "为什么不用明文口令？",
    "start": 84.9,
    "end": 86.233
  },
  {
    "id": "cap-023",
    "text": "抓包就能读到，代理和日志都会留一份。",
    "start": 86.8,
    "end": 90
  },
  {
    "id": "cap-024",
    "text": "同一份凭据还能被反复重放。",
    "start": 90.567,
    "end": 93.033
  },
  {
    "id": "cap-025",
    "text": "摘要认证不是新发明，它是 HTTP 里的一项可选机制。",
    "start": 94.133,
    "end": 99.1
  },
  {
    "id": "cap-026",
    "text": "规范定义了字段、算法和拼接方式。",
    "start": 99.7,
    "end": 103.233
  },
  {
    "id": "cap-027",
    "text": "我们按规范里的例子来讲。",
    "start": 103.8,
    "end": 105.5
  },
  {
    "id": "cap-028",
    "text": "客户端真正发出去的，就是这一行头。",
    "start": 106.6,
    "end": 109.567
  },
  {
    "id": "cap-029",
    "text": "用户名、域、路径、还有一串计数器。",
    "start": 110.167,
    "end": 114
  },
  {
    "id": "cap-030",
    "text": "这些字段拼起来，才得到最终的摘要。",
    "start": 114.6,
    "end": 117.6
  },
  {
    "id": "cap-031",
    "text": "一次请求牵涉的角色可以列成一圈。",
    "start": 118.7,
    "end": 121.5
  },
  {
    "id": "cap-032",
    "text": "客户端负责算，服务端负责比。",
    "start": 122.067,
    "end": 124.533
  },
  {
    "id": "cap-033",
    "text": "代理、缓存、日志各取所需。",
    "start": 125.1,
    "end": 128.567
  },
  {
    "id": "cap-034",
    "text": "职责天然落在两侧。",
    "start": 129.667,
    "end": 131.2
  },
  {
    "id": "cap-035",
    "text": "客户端算摘要，服务端生成挑战并比对。",
    "start": 131.767,
    "end": 134.9
  },
  {
    "id": "cap-036",
    "text": "两边共享的只有那把密钥。",
    "start": 135.467,
    "end": 137.7
  },
  {
    "id": "cap-037",
    "text": "算法分三档，按需选。",
    "start": 139.633,
    "end": 141.9
  },
  {
    "id": "cap-038",
    "text": "弱摘要容易撞，强摘要成本高。",
    "start": 142.433,
    "end": 145.433
  },
  {
    "id": "cap-039",
    "text": "多数新系统直接从第三档起步。",
    "start": 145.967,
    "end": 148.767
  },
  {
    "id": "cap-040",
    "text": "摘要值来自四层东西。",
    "start": 149.867,
    "end": 151.767
  },
  {
    "id": "cap-041",
    "text": "先定算法，再定字段顺序，然后规范化和拼接。",
    "start": 152.333,
    "end": 156.567
  },
  {
    "id": "cap-042",
    "text": "顺序一旦定错，摘要必然不等。",
    "start": 157.133,
    "end": 160
  },
  {
    "id": "cap-043",
    "text": "新旧写法逐项对照，差别不小。",
    "start": 161.1,
    "end": 163.8
  },
  {
    "id": "cap-044",
    "text": "旧写法里算法是缺省的，新写法必须写明。",
    "start": 164.367,
    "end": 167.767
  },
  {
    "id": "cap-045",
    "text": "用户名是否进摘要也换了约定。",
    "start": 168.333,
    "end": 170.8
  },
  {
    "id": "cap-046",
    "text": "口令本身不会离开客户端。",
    "start": 171.9,
    "end": 174.033
  },
  {
    "id": "cap-047",
    "text": "它先被压成摘要，再进网。",
    "start": 174.633,
    "end": 176.933
  },
  {
    "id": "cap-048",
    "text": "服务器只见到摘要这一种形态。",
    "start": 177.533,
    "end": 179.8
  },
  {
    "id": "cap-049",
    "text": "强度可以分三档看。",
    "start": 180.9,
    "end": 182.533
  },
  {
    "id": "cap-050",
    "text": "不加密、弱摘要、强摘要。",
    "start": 183.1,
    "end": 185.867
  },
  {
    "id": "cap-051",
    "text": "公网场景基本只考虑第三档。",
    "start": 186.433,
    "end": 188.833
  },
  {
    "id": "cap-052",
    "text": "弱算法被淘汰是有原因的。",
    "start": 189.933,
    "end": 192.267
  },
  {
    "id": "cap-053",
    "text": "摘要长度有限，可以被穷举。",
    "start": 192.833,
    "end": 195.233
  },
  {
    "id": "cap-054",
    "text": "碰撞也更容易被构造出来。",
    "start": 195.833,
    "end": 197.567
  },
  {
    "id": "cap-055",
    "text": "拼接顺序必须是双方约定的。",
    "start": 198.667,
    "end": 201
  },
  {
    "id": "cap-056",
    "text": "规范给出了规范串的定义。",
    "start": 201.567,
    "end": 203.567
  },
  {
    "id": "cap-057",
    "text": "顺序错了，摘要就对不上。",
    "start": 204.133,
    "end": 206.333
  },
  {
    "id": "cap-058",
    "text": "规范化之后，请求变成四段。",
    "start": 207.433,
    "end": 209.9
  },
  {
    "id": "cap-059",
    "text": "方法、路径、认证参数、摘要前缀。",
    "start": 210.467,
    "end": 214.433
  },
  {
    "id": "cap-060",
    "text": "它们按固定顺序排好，再拼起来。",
    "start": 215,
    "end": 217.5
  },
  {
    "id": "cap-061",
    "text": "谁有权定义这个顺序？",
    "start": 218.6,
    "end": 220.3
  },
  {
    "id": "cap-062",
    "text": "规范说了算，客户端和服务端都照它执行。",
    "start": 220.9,
    "end": 224.5
  },
  {
    "id": "cap-063",
    "text": "测试向量用来保证两边一致。",
    "start": 225.067,
    "end": 227.433
  },
  {
    "id": "cap-064",
    "text": "请求侧和响应侧的字段不一样。",
    "start": 228.533,
    "end": 230.933
  },
  {
    "id": "cap-065",
    "text": "请求侧关心方法和路径。",
    "start": 231.5,
    "end": 233.533
  },
  {
    "id": "cap-066",
    "text": "响应侧关心摘要本身和随机串。",
    "start": 234.1,
    "end": 236.733
  },
  {
    "id": "cap-067",
    "text": "顺序有三种取法。",
    "start": 237.833,
    "end": 239.4
  },
  {
    "id": "cap-068",
    "text": "手写固定序、按字典序、按规范序。",
    "start": 240,
    "end": 243.6
  },
  {
    "id": "cap-069",
    "text": "新系统应该走第三种。",
    "start": 244.133,
    "end": 245.833
  },
  {
    "id": "cap-070",
    "text": "字段本身也分四层。",
    "start": 246.933,
    "end": 248.7
  },
  {
    "id": "cap-071",
    "text": "原始头字段先规范化，再拼接，最后摘要。",
    "start": 249.233,
    "end": 253.433
  },
  {
    "id": "cap-072",
    "text": "每一层都可能出错。",
    "start": 254.033,
    "end": 255.367
  },
  {
    "id": "cap-073",
    "text": "有没有计数器，差别很大。",
    "start": 257.3,
    "end": 259.433
  },
  {
    "id": "cap-074",
    "text": "没有计数器，原样重放就能通过。",
    "start": 260,
    "end": 262.7
  },
  {
    "id": "cap-075",
    "text": "有了计数器，序号必须递增。",
    "start": 263.3,
    "end": 265.733
  },
  {
    "id": "cap-076",
    "text": "重放被压进一个窗口里。",
    "start": 266.833,
    "end": 268.533
  },
  {
    "id": "cap-077",
    "text": "报文进来，先看序号是否用过。",
    "start": 269.067,
    "end": 271.867
  },
  {
    "id": "cap-078",
    "text": "用过就直接拒绝。",
    "start": 272.433,
    "end": 273.867
  },
  {
    "id": "cap-079",
    "text": "重放防护同样分三档。",
    "start": 274.967,
    "end": 277.167
  },
  {
    "id": "cap-080",
    "text": "只有随机串最弱，加上计数就好些。",
    "start": 277.7,
    "end": 280.533
  },
  {
    "id": "cap-081",
    "text": "再加时间窗口才算稳。",
    "start": 281.1,
    "end": 282.967
  },
  {
    "id": "cap-082",
    "text": "时钟偏了就会失败。",
    "start": 284.067,
    "end": 285.767
  },
  {
    "id": "cap-083",
    "text": "客户端快了一点，服务端就判过期。",
    "start": 286.333,
    "end": 289.233
  },
  {
    "id": "cap-084",
    "text": "请求直接被拒，没有补救机会。",
    "start": 289.8,
    "end": 292.433
  },
  {
    "id": "cap-085",
    "text": "规范对时钟有明确要求。",
    "start": 293.533,
    "end": 295.633
  },
  {
    "id": "cap-086",
    "text": "两侧时间必须足够接近。",
    "start": 296.2,
    "end": 298.033
  },
  {
    "id": "cap-087",
    "text": "偏差过大会被当成异常。",
    "start": 298.6,
    "end": 300.733
  },
  {
    "id": "cap-088",
    "text": "每次请求都要变的东西有三个。",
    "start": 301.833,
    "end": 304.3
  },
  {
    "id": "cap-089",
    "text": "计数器自增，随机串重算，质量参数固定。",
    "start": 304.867,
    "end": 308.6
  },
  {
    "id": "cap-090",
    "text": "这三个字段是防重放的关键。",
    "start": 309.2,
    "end": 311.533
  },
  {
    "id": "cap-091",
    "text": "有代理的时候，链路会变长。",
    "start": 312.633,
    "end": 314.933
  },
  {
    "id": "cap-092",
    "text": "每一跳都可能看到明文。",
    "start": 315.5,
    "end": 317.067
  },
  {
    "id": "cap-093",
    "text": "缓存和日志还会各自留一份。",
    "start": 317.633,
    "end": 320.233
  },
  {
    "id": "cap-094",
    "text": "于是有了逐跳和端到端两种做法。",
    "start": 321.333,
    "end": 323.933
  },
  {
    "id": "cap-095",
    "text": "逐跳便宜，但只覆盖一段。",
    "start": 324.5,
    "end": 326.867
  },
  {
    "id": "cap-096",
    "text": "端到端贵，覆盖整条链。",
    "start": 327.467,
    "end": 329.867
  },
  {
    "id": "cap-097",
    "text": "部署方式常见三种。",
    "start": 330.967,
    "end": 332.7
  },
  {
    "id": "cap-098",
    "text": "全链摘要最彻底，也最贵。",
    "start": 333.233,
    "end": 335.867
  },
  {
    "id": "cap-099",
    "text": "逐跳摘要是折中，边缘摘要介于两者之间。",
    "start": 336.433,
    "end": 340.267
  },
  {
    "id": "cap-100",
    "text": "每一跳要做四件事。",
    "start": 341.367,
    "end": 343.133
  },
  {
    "id": "cap-101",
    "text": "先认证，再转发，然后重新认证，最后落库。",
    "start": 343.7,
    "end": 347.833
  },
  {
    "id": "cap-102",
    "text": "任何一跳漏掉都会断链。",
    "start": 348.4,
    "end": 350.4
  },
  {
    "id": "cap-103",
    "text": "覆盖范围的差别不在算法。",
    "start": 351.5,
    "end": 353.633
  },
  {
    "id": "cap-104",
    "text": "在链路长度。",
    "start": 354.2,
    "end": 355.2
  },
  {
    "id": "cap-105",
    "text": "一跳和整条链是两个量级。",
    "start": 355.767,
    "end": 358.267
  },
  {
    "id": "cap-106",
    "text": "密钥也随 hops 拆开。",
    "start": 359.367,
    "end": 361.4
  },
  {
    "id": "cap-107",
    "text": "共享密钥变成每跳一把。",
    "start": 361.967,
    "end": 363.967
  },
  {
    "id": "cap-108",
    "text": "好处是任何一把都能单独撤回。",
    "start": 364.533,
    "end": 367.5
  },
  {
    "id": "cap-109",
    "text": "真正接入要改三处。",
    "start": 369.433,
    "end": 371.333
  },
  {
    "id": "cap-110",
    "text": "选算法、配字段、对齐顺序。",
    "start": 371.9,
    "end": 374.8
  },
  {
    "id": "cap-111",
    "text": "顺序那一步最容易被漏掉。",
    "start": 375.367,
    "end": 377.567
  },
  {
    "id": "cap-112",
    "text": "代价也是从这三处来的。",
    "start": 378.667,
    "end": 380.6
  },
  {
    "id": "cap-113",
    "text": "每跳多算一次，两侧顺序要对齐。",
    "start": 381.167,
    "end": 384.067
  },
  {
    "id": "cap-114",
    "text": "调试成本明显上升。",
    "start": 384.633,
    "end": 386.4
  },
  {
    "id": "cap-115",
    "text": "但要先记住一件事。",
    "start": 387.5,
    "end": 388.767
  },
  {
    "id": "cap-116",
    "text": "摘要是可选机制，不开就没有这些代价。",
    "start": 389.333,
    "end": 392.4
  },
  {
    "id": "cap-117",
    "text": "代价集中在顺序和时钟上。",
    "start": 393,
    "end": 395.667
  },
  {
    "id": "cap-118",
    "text": "落到配置上就是这几行。",
    "start": 396.767,
    "end": 398.733
  },
  {
    "id": "cap-119",
    "text": "算法写明，质量参数写明，计数器每次自增。",
    "start": 399.3,
    "end": 403.3
  },
  {
    "id": "cap-120",
    "text": "顺序仍然要对齐。",
    "start": 403.9,
    "end": 405.367
  },
  {
    "id": "cap-121",
    "text": "落地会碰到四个组件。",
    "start": 406.467,
    "end": 408.033
  },
  {
    "id": "cap-122",
    "text": "网关、应用、客户端，还有运维。",
    "start": 408.633,
    "end": 412.133
  },
  {
    "id": "cap-123",
    "text": "每一个都要改。",
    "start": 412.7,
    "end": 413.733
  },
  {
    "id": "cap-124",
    "text": "代价最终落在两侧。",
    "start": 414.833,
    "end": 416.433
  },
  {
    "id": "cap-125",
    "text": "客户端多存一次摘要。",
    "start": 417,
    "end": 418.633
  },
  {
    "id": "cap-126",
    "text": "服务端多算一次摘要。",
    "start": 419.2,
    "end": 420.767
  },
  {
    "id": "cap-127",
